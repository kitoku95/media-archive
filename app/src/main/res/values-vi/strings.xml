    <!-- About Screen (Strict HR-07: User-facing features only, no tech jargon) -->
    <string name="about_title">Giới thiệu</string>
    <string name="about_tagline">Không gian lưu trữ và xem ảnh, video gọn gàng</string>
    <string name="about_description">Sắp xếp và thưởng thức ảnh, video cá nhân theo từng danh mục riêng biệt phù hợp với nhu cầu của bạn. Chỉ thêm những tệp hoặc thư mục bạn trực tiếp lựa chọn mà không tự động quét toàn bộ thiết bị. Bảo vệ các bộ sưu tập nhạy cảm trong danh mục riêng tư bằng mật khẩu của riêng bạn.</string>
    <string name="about_feature_organize">Phân loại ảnh và video theo từng danh mục rõ ràng</string>
    <string name="about_feature_manual">Chủ động chọn lọc từng tệp hoặc thư mục muốn thêm</string>
    <string name="about_feature_privacy">Khóa các danh mục riêng tư bằng mật khẩu cá nhân</string>

