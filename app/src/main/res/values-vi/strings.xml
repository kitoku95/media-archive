    <!-- About Screen (Strict HR-07: User-facing features only, no tech jargon) -->
    <string name="about_title">Giới thiệu</string>
    <string name="about_tagline">Không gian lưu trữ ảnh, video và tài liệu gọn gàng</string>
    <string name="about_description">Sắp xếp ảnh, video và tài liệu cá nhân trong các danh mục tách biệt phù hợp với nhu cầu của bạn. Chỉ thêm những tệp hoặc thư mục bạn trực tiếp lựa chọn mà không tự động quét toàn bộ thiết bị. Bảo vệ các bộ sưu tập nhạy cảm trong danh mục riêng tư bằng mật khẩu của riêng bạn.</string>
    <string name="about_feature_organize_media">Xem ảnh và video gọn gàng trong danh mục Ảnh / Video riêng biệt</string>
    <string name="about_feature_organize_documents">Lưu trữ và mở nhanh PDF, văn bản, tệp văn phòng trong danh mục Tài liệu</string>
    <string name="about_feature_manual">Chủ động chọn lọc từng tệp hoặc thư mục muốn thêm</string>
    <string name="about_feature_privacy">Khóa các danh mục riêng tư bằng mật khẩu cá nhân</string>

